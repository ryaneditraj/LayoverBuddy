# Copy to .env for local overrides. The app reads the process environment.
# Nothing here is a secret. LayoverBuddy does not call a paid API.

# Bind address and port. Defaults match the current `python app.py` behavior.
HOST=0.0.0.0
PORT=5000

# Keep this off unless you are debugging on your own machine.
FLASK_DEBUG=0

# Public origin used for canonical links, Open Graph, robots.txt, and the sitemap.
# Set this in production, for example https://layoverbuddy.example.com
SITE_URL=

# Set to 1 only when a reverse proxy in front of the app sets X-Forwarded-* headers.
TRUST_PROXY=0
